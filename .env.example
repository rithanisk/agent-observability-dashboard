# Local development database. Replace this with the Supabase session-pooler URL
# in hosted environments.
DATABASE_URL=postgresql+asyncpg://tracewell:tracewell@localhost:5433/tracewell

# Public URL used by the Next.js browser application.
NEXT_PUBLIC_API_URL=http://localhost:8000

# SoCLaaS is only used by the demo agents and controlled evaluation jobs.
SOCLAAS_BASE_URL=https://soclaas-api.comp.nus.edu.sg/v1
SOCLAAS_MODEL=qwen3.5:9b
SOCLAAS_API_KEY=

# Protects OTLP ingestion when the API is exposed publicly. Empty is allowed
# only in local development.
TRACEWELL_INGEST_TOKEN=
TRACEWELL_ENV=development
TRACEWELL_AUTO_CREATE_SCHEMA=true
TRACEWELL_SELF_OTLP_URL=http://127.0.0.1:8000/v1/traces
